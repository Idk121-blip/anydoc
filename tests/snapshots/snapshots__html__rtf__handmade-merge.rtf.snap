<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Inherited heading</title>
<style>
body { font-family: system-ui, sans-serif; line-height: 1.5; max-width: 50rem; margin: 2rem auto; padding: 0 1rem; }
table { border-collapse: collapse; margin: 1rem 0; }
th, td { border: 1px solid #999; padding: 0.25rem 0.5rem; vertical-align: top; }
table.layout, table.layout td { border: none; }
img { max-width: 100%; }
pre { overflow-x: auto; }
</style>
</head>
<body>
<h2 id="inherited-heading">Inherited heading</h2>
<p>Plain paragraph between tables.</p>
<table>
<tbody>
<tr><td rowspan="2">A1</td><td colspan="2">B1</td><td>C1</td></tr>
<tr><td colspan="3">Wide B2</td></tr>
<tr><td colspan="2">A3 wide</td><td colspan="2">B3 wide</td></tr>
<tr><td colspan="2">stray continuation</td><td colspan="2">X</td></tr>
</tbody>
</table>
</body>
</html>
